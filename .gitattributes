# Normalize all text files to LF in the repository and working tree
* text=auto eol=lf

# Windows batch scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
